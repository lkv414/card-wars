# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Supabase CLI secrets (local-only, never commit)
.env
.env.secure
# NOTE: .env.example and .env.production are COMMITTED to the repo on
# purpose. .env.production holds the Supabase anon publishable key
# (which is client-safe by design) plus the Cloudflare Workers URL
# so `npm install && npm run build` produces a working bundle with
# zero setup. See BUILD_ENV.md for the full rationale.
workers/.dev.vars
.dev.vars
supabase/.temp
supabase/.branches

# Agent skills — committed copy is in skills/ (see skills/README.md)
.agents/
.claude/skills/
agent/skills/
data/skills/

# Local card catalog artifacts (generated by scripts/)
data/
.archive/
scripts/__pycache__/



# Debug artifacts (crash dumps, curl outputs) — never commit
*.stackdump
response.txt

# Local debug artifacts (DB dumps, identifier sqlite) — never commit
dumps/
identifier.sqlite

# Agent runtime metadata (created by desktop agent runs)
.reasonix/
reasonix.toml
remote-mcp-server-authless/
