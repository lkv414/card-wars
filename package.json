{
  "name": "card-wars",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm version:auto && pnpm -r build",
    "dev:server": "pnpm --filter @card-wars/server dev",
    "version:auto": "node tools/bump-version.mjs auto",
    "version:bump": "node tools/bump-version.mjs patch",
    "version:sync": "node tools/bump-version.mjs sync",
    "deploy": "pnpm version:auto && pnpm -r build && pnpm --filter @card-wars/server deploy"
  },
  "devDependencies": {
    "eslint": "^9.30.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.35.0"
  },
  "version": "3.1.140"
}
