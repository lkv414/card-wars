{
  "name": "card-game",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.18 <23"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "dev": "vite",
    "test": "node --test src/**/*.test.js",
    "test:smoke": "vitest run",
    "test:supabase": "vitest run --config vitest.supabase.config.js",
    "test:store": "vitest run --config vitest.store.config.js",
    "db:push": "node scripts/db-push.mjs",
    "db:schema": "node scripts/generate-db-schema.mjs",
    "catalog:migrate": "node scripts/migrate-catalog-to-kv.mjs",
    "catalog:mechanics": "node scripts/assign-mechanics-status.mjs && node scripts/build-individual-supabase-sql.mjs",
    "ocr": "node scripts/ocr-cards.mjs",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "workers:dev": "wrangler dev --config workers/wrangler.dev.jsonc",
    "workers:deploy": "wrangler deploy --config workers/wrangler.jsonc",
    "workers:check": "wrangler deploy --dry-run --config workers/wrangler.jsonc"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.2.0",
    "@supabase/supabase-js": "^2.108.2",
    "opencode-antigravity-auth": "^1.6.0",
    "postprocessing": "^6.39.5",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.18.1",
    "three": "^0.185.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260813.1",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^26.1.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "supabase": "^2.109.1",
    "typescript": "^5.9.2",
    "vite": "^8.0.12",
    "vitest": "^3.2.4",
    "wrangler": "^4.125.0"
  }
}
